# Supabase (Project Settings -> API). The service role key is SERVER-ONLY. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (https://aistudio.google.com/apikey) - free tier is enough
GEMINI_API_KEY=your-gemini-api-key
# Optional: any free-tier model that supports JSON output. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
